---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { CONTACT, CV_PATH } from '../data/site';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const { contact, hero } = dict;

/**
 * Cuatro canales, uno por medio. Antes había dos números de teléfono
 * distintos —fijo y WhatsApp—, lo que obligaba al reclutador a elegir sin
 * saber cuál usar. Queda solo WhatsApp, y entra GitHub.
 */
const channels = [
  {
    icon: 'mail' as const,
    label: contact.email,
    value: CONTACT.email,
    href: `mailto:${CONTACT.email}`,
    external: false,
  },
  {
    icon: 'message-circle' as const,
    label: contact.whatsapp,
    value: CONTACT.whatsappLabel,
    href: `https://wa.me/${CONTACT.whatsapp}`,
    external: true,
  },
  {
    icon: 'linkedin' as const,
    label: contact.linkedin,
    value: CONTACT.linkedinLabel,
    href: CONTACT.linkedin,
    external: true,
  },
  {
    icon: 'github' as const,
    label: contact.github,
    value: CONTACT.githubLabel,
    href: CONTACT.github,
    external: true,
  },
];
---

<Section id="contacto" title={contact.title} intro={contact.intro}>
  <ul class="max-w-[70ch] border-t border-rule">
    {
      channels.map((channel) => (
        <li>
          <a
            href={channel.href}
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noopener' : undefined}
            class="row-hover group flex items-center gap-4 border-b border-rule px-2 py-5 hover:bg-surface"
          >
            <Icon
              name={channel.icon}
              class="shrink-0 text-muted transition-colors group-hover:text-amber"
            />
            <span class="text-body font-medium text-text">{channel.label}</span>
            <span class="ml-auto text-right text-meta text-muted transition-colors group-hover:text-amber">
              {channel.value}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <a
    href={CV_PATH}
    target="_blank"
    rel="noopener"
    class="mt-10 inline-flex rounded-xs bg-amber px-6 py-3.5 text-meta font-semibold text-bg transition-opacity hover:opacity-90"
  >
    {contact.cta}
    <span class="sr-only"> ({hero.cvHint})</span>
  </a>
</Section>
