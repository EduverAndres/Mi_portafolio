---
import Section from './Section.astro';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const { skills } = dict;

/** Peso visual de cada nivel: la barra dice de un vistazo cuánto pesa el grupo. */
const anchura: Record<string, string> = {
  core: 'w-full',
  solid: 'w-2/3',
  familiar: 'w-1/3',
};
---

{/*
  Antes esto era una nube de más de cincuenta etiquetas idénticas donde todo
  pesaba igual y por tanto nada destacaba, y hacía ver generalista.

  Ahora los tres niveles declaran qué se domina de verdad: Core es lo que se
  sostiene en una entrevista técnica; Familiarizado admite abiertamente que no
  es su fuerte. Esa honestidad se lee como criterio, no como carencia.

  Ya no es una isla de Preact: no hay nada que plegar, así que la sección es
  HTML estático y no envía JavaScript.
*/}
<Section id="habilidades" title={skills.title} intro={skills.intro}>
  <div class="space-y-10">
    {
      skills.levels.map((level) => (
        <div>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h3 class="font-display text-xl font-semibold text-text">{level.name}</h3>
            <p class="text-meta text-muted">{level.note}</p>
          </div>

          {/* La barra se dibuja sola al entrar en pantalla, con
              animation-timeline. Sin JavaScript, y sin salto donde el
              navegador no lo soporte: ahí aparece ya dibujada. */}
          <div class="mt-3 h-px w-full bg-rule">
            <div
              class:list={[
                'level-bar h-px bg-amber',
                anchura[level.id] ?? 'w-1/3',
              ]}
            />
          </div>

          <ul class="mt-5 flex flex-wrap gap-2">
            {level.items.map((item) => (
              <li
                class:list={[
                  'rounded-pill border px-3 py-1.5 text-meta',
                  level.id === 'core'
                    ? 'border-amber/40 bg-amber/10 font-medium text-text'
                    : 'border-rule-strong bg-surface text-muted',
                ]}
              >
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
