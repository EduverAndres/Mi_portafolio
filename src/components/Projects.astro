---
import Section from './Section.astro';
import { PROJECTS } from '../data/site';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const { projects } = dict;
---

{/*
  Se eliminó la tarjeta fantasma de "En construcción" y la nota que decía que
  la sección estaba incompleta: un hueco visible pesa más que tener menos
  proyectos.

  En su lugar queda un bloque reservado y maquetado para el caso de ingeniería
  de datos. No finge ser un proyecto: se presenta como trabajo en preparación,
  con su alcance descrito, para que el día que exista el repositorio solo haya
  que rellenar los datos en src/data/site.ts.
*/}
<Section id="proyectos" title={projects.title}>
  <div class="border-t border-rule">
    {
      PROJECTS.map((project, index) => {
        const copy = projects.items[project.id as keyof typeof projects.items];
        const imageFirst = index % 2 === 0;

        return (
          <article class="grid items-center gap-8 border-b border-rule py-10 lg:grid-cols-2 lg:gap-14 lg:py-14">
            <img
              src={project.image}
              alt={copy.imageAlt}
              width={project.width}
              height={project.height}
              loading="lazy"
              decoding="async"
              class:list={[
                'w-full border border-rule bg-surface',
                imageFirst ? 'lg:order-1' : 'lg:order-2',
              ]}
            />

            <div class:list={[imageFirst ? 'lg:order-2' : 'lg:order-1']}>
              {/* Etiqueta de estado: cuando un proyecto todavía no es un
                  negocio en marcha, se dice antes de describirlo. */}
              {copy.status && (
                <p class="mb-3 inline-block rounded-pill border border-amber/40 bg-amber/10 px-3 py-1 text-meta font-medium text-amber">
                  {copy.status}
                </p>
              )}
              <h3 class="font-display text-2xl font-semibold text-text">{copy.name}</h3>
              <p class="mt-1 text-meta text-muted">{copy.role}</p>

              <p class="mt-5 max-w-[52ch] text-body text-text/85">{copy.description}</p>

              <p class="mt-5 max-w-[52ch] text-meta text-muted">{copy.tags.join(', ')}</p>

              <a
                href={project.url}
                target="_blank"
                rel="noopener"
                class="mt-7 inline-block text-meta font-semibold text-amber underline decoration-amber/40 underline-offset-6 transition-colors hover:decoration-amber"
              >
                {projects.visit}
                <span class="sr-only"> ({projects.opensNewTab})</span>
              </a>
            </div>
          </article>
        );
      })
    }

    {/* Bloque reservado. Borde discontinuo y sin enlace: se lee como una
        casilla pendiente y honesta, no como un proyecto que no existe. */}
    <article class="border-b border-rule py-10 lg:py-14">
      <div class="max-w-[62ch] border border-dashed border-rule-strong px-6 py-8">
        <p class="text-meta font-semibold text-amber">{projects.reserved.label}</p>
        <h3 class="font-display mt-2 text-2xl font-semibold text-text">
          {projects.reserved.name}
        </h3>
        <p class="mt-4 text-body text-text/85">{projects.reserved.description}</p>
      </div>
    </article>
  </div>
</Section>
