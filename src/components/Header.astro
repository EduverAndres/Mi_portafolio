---
import { CV_PATH, CONTACT, PERSON } from '../data/site';
import { localizePath, otherLang, LANGUAGES, type Dict, type Lang } from '../i18n';
import Icon from './Icon.astro';
import MobileNav from './MobileNav';

interface Props {
  lang: Lang;
  dict: Dict;
}

const { lang, dict } = Astro.props;
const home = localizePath('/', lang);

const links = [
  { href: '#experiencia', label: dict.nav.experiencia },
  { href: '#proyectos', label: dict.nav.proyectos },
  { href: '#habilidades', label: dict.nav.habilidades },
  { href: '#docencia', label: dict.nav.docencia },
  { href: '#educacion', label: dict.nav.educacion },
  { href: '#contacto', label: dict.nav.contacto },
];

const target = otherLang(lang);
const targetPath = localizePath('/', target);
---

<header
  class="fixed top-0 right-0 left-0 z-50 border-b border-rule bg-bg/90 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5 sm:px-8">
    <a
      href={home}
      class="font-display text-lg font-bold tracking-tight text-text"
      aria-label={PERSON.name}
    >
      {PERSON.initials}<span class="text-amber">.</span>
    </a>

    <nav class="ml-auto hidden lg:block" aria-label={dict.nav.experiencia}>
      <ul class="flex items-center gap-6">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-meta text-muted transition-colors hover:text-text"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-4 lg:ml-6">
      {/* GitHub también en el nav: para un perfil de ingeniería, el código
          tiene que estar a un clic desde cualquier punto de la página. */}
      <a
        href={CONTACT.github}
        target="_blank"
        rel="noopener"
        class="text-muted transition-colors hover:text-amber"
        aria-label={`${dict.nav.github} (${dict.projects.opensNewTab})`}
      >
        <Icon name="github" size={19} />
      </a>

      {/* Cambiar de idioma es navegar a otra URL: un enlace basta. Nada que
          hidratar, y funciona sin JavaScript. En pantallas estrechas se
          reduce a dos letras para no comerse la barra. */}
      <a
        href={targetPath}
        hreflang={LANGUAGES[target].htmlLang}
        rel="alternate"
        class="text-meta font-medium text-muted transition-colors hover:text-text"
        aria-label={`${dict.nav.langLabel}: ${dict.nav.switchTo}`}
      >
        <span class="sm:hidden">{dict.nav.switchToShort}</span>
        <span class="hidden sm:inline">{dict.nav.switchTo}</span>
      </a>

      <a
        href={CV_PATH}
        target="_blank"
        rel="noopener"
        class="hidden rounded-xs bg-amber px-4 py-2 text-meta font-semibold text-bg transition-opacity hover:opacity-90 sm:inline-flex"
      >
        {dict.nav.cv}
        <span class="sr-only"> ({dict.hero.cvHint})</span>
      </a>

      {/* Solo se le pasan las cadenas que usa: las props de una isla viajan
          serializadas en el HTML, y el diccionario completo lo inflaría. */}
      <MobileNav
        client:idle
        links={links}
        cvPath={CV_PATH}
        githubUrl={CONTACT.github}
        labels={{
          open: dict.nav.openMenu,
          close: dict.nav.closeMenu,
          cv: dict.nav.cv,
          cvHint: dict.hero.cvHint,
          github: dict.nav.github,
        }}
      />
    </div>
  </div>
</header>
