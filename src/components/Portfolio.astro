---
import Hero from './Hero.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Teaching from './Teaching.astro';
import Education from './Education.astro';
import Contact from './Contact.astro';
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  dict: Dict;
}

const { dict } = Astro.props;
---

{/*
  Orden de secciones. Desaparece el antiguo bloque "Perfil": su contenido era
  la frase de posicionamiento del héroe, y repetirlo debajo solo diluía.

  Docencia baja después de Proyectos y Habilidades: suma como diferenciador,
  pero no puede competir con el material técnico en la parte alta.
*/}
<Hero dict={dict} />
<Experience dict={dict} />
<Projects dict={dict} />
<Skills dict={dict} />
<Teaching dict={dict} />
<Education dict={dict} />
<Contact dict={dict} />
