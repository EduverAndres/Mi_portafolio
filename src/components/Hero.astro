---
import { CV_PATH, COMPANIES, HERO_STACK, PERSON } from '../data/site';
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  dict: Dict;
}

const { dict } = Astro.props;
const { hero } = dict;
---

{/*
  La placa. Único bloque oscuro del sitio y único lugar donde se gasta audacia.
  Todo su contenido es HTML estático: se ve completo en el primer frame, sin
  esperar a JavaScript. Orden deliberado: disponibilidad, nombre, rol, valor,
  PRUEBA y acciones — la evidencia va antes que los botones porque un reclutador
  decide contactar después de verla.
*/}
<section class="on-ink bg-ink text-ink-fg" aria-labelledby="hero-name">
  <div class="mx-auto max-w-6xl px-5 pt-28 pb-14 sm:px-8 sm:pt-36 sm:pb-20">
    <p class="flex items-center gap-2.5 text-meta text-ink-fg">
      <span
        class="inline-block h-2 w-2 shrink-0 rounded-full bg-live ring-3 ring-live/25"
        aria-hidden="true"
      ></span>
      {hero.available}
    </p>

    <h1
      id="hero-name"
      class="font-display mt-6 text-display-xl font-bold text-balance"
    >
      {PERSON.firstName}<br />{PERSON.lastName}
    </h1>

    {/* Los dos roles, en los términos que un ATS busca literalmente.
        Separados por la rejilla, no por un punto medio. */}
    <p class="mt-6 flex flex-col text-body-l font-medium sm:flex-row sm:items-center">
      <span>{hero.roles[0]}</span>
      <span
        class="mt-1 sm:mt-0 sm:ml-5 sm:border-l sm:border-ink-rule sm:pl-5"
      >{hero.roles[1]}</span>
    </p>

    <p class="mt-5 max-w-[46ch] text-body-l text-ink-fg/85">
      {hero.value}
    </p>

    {/* Franja de evidencia: años, empresas y stack compuestos como una fila de
        datos. Es lo que carga la prueba, y lo único que se anima al cargar. */}
    <dl
      class="mt-12 grid grid-cols-1 border-t border-ink-rule sm:grid-cols-[auto_1fr_1.4fr]"
    >
      <div
        class="evidence-cell border-b border-ink-rule py-5 sm:border-b-0 sm:pr-10"
        style="--cell-index: 0"
      >
        <dd class="font-display nums text-4xl font-bold sm:text-5xl">
          {hero.evidence.experienceValue}
        </dd>
        <dt class="mt-1 text-meta text-ink-muted">{hero.evidence.experience}</dt>
      </div>

      <div
        class="evidence-cell border-b border-ink-rule py-5 sm:border-b-0 sm:border-l sm:px-10"
        style="--cell-index: 1"
      >
        <dd class="flex flex-wrap items-baseline gap-x-5 gap-y-1 text-body-l font-semibold">
          {COMPANIES.map((company) => <span>{company}</span>)}
        </dd>
        <dt class="mt-2 text-meta text-ink-muted">{hero.evidence.companies}</dt>
      </div>

      <div
        class="evidence-cell py-5 sm:border-l sm:border-ink-rule sm:pl-10"
        style="--cell-index: 2"
      >
        <dd class="flex flex-wrap gap-x-4 gap-y-1 text-body text-ink-fg/90">
          {HERO_STACK.map((tech) => <span>{tech}</span>)}
        </dd>
        <dt class="mt-2 text-meta text-ink-muted">{hero.evidence.stack}</dt>
      </div>
    </dl>

    {/* Dos acciones que no se parecen: una placa sólida clara y un enlace de
        texto. Sin flechas pegadas al rótulo. */}
    <div class="mt-11 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
      <a
        href={CV_PATH}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center rounded-xs bg-paper px-6 py-3.5 text-meta font-semibold text-ink transition-colors hover:bg-white"
      >
        {hero.ctaPrimary}
        <span class="sr-only"> ({hero.cvHint})</span>
      </a>

      <a
        href="#contacto"
        class="text-meta font-medium text-ink-fg underline decoration-ink-muted underline-offset-6 transition-colors hover:decoration-ink-fg"
      >
        {hero.ctaSecondary}
      </a>
    </div>
  </div>
</section>
