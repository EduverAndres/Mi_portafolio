---
interface Props {
  id: string;
  title: string;
  /** Texto breve bajo el título. Opcional: la mayoría de secciones no lo necesita. */
  intro?: string;
}

const { id, title, intro } = Astro.props;
---

{/*
  Encabezado común. Sin numerar (01 · 02 · 03): estas secciones no son una
  secuencia, y numerarlas solo añadiría ruido. La sección se abre con el título
  y una regla de 1px; no hay tarjeta, sombra ni fondo que la envuelva.
*/}
<section id={id} class="scroll-mt-16 border-t border-rule py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <h2 class="font-display text-display-l font-semibold">{title}</h2>
    {intro && <p class="mt-4 max-w-[60ch] text-body-l text-text/75">{intro}</p>}

    <div class="mt-10 sm:mt-12">
      <slot />
    </div>
  </div>
</section>
