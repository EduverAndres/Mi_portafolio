---
import { PERSON } from '../data/site';
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  dict: Dict;
}

const { dict } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-rule py-10">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-5 text-meta text-muted sm:flex-row sm:items-center sm:px-8"
  >
    <p class="nums">
      © {year} {PERSON.name} — {dict.footer.location}
    </p>

    {/* Enlace, no botón con scroll por JavaScript: el desplazamiento suave lo
        pone el CSS y funciona sin hidratar nada. */}
    <a
      href="#main"
      class="underline decoration-rule-strong underline-offset-4 transition-colors hover:text-text hover:decoration-amber sm:ml-auto"
    >
      {dict.footer.toTop}
    </a>
  </div>
</footer>
